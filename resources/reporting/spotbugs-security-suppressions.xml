<?xml version="1.0" encoding="UTF-8"?>
<!-- Baseline of pre-existing SpotBugs/FindSecBugs SECURITY findings accepted on 2026-09-04.
     Each <Match> suppresses ONE accepted finding so the build gates on NEW findings only.
     Work through these (prioritise the high-priority ones: SSRF, PATH_TRAVERSAL,
     WEAK_MESSAGE_DIGEST_MD5, XSS_SERVLET) and delete the matching <Match> as you fix it.
     Regenerate: mvn spotbugs:spotbugs, then re-derive matches from target/spotbugsXml.xml. -->
<FindBugsFilter>
<Match>
  <Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE"/>
  <Class name="dev.luin.file.server.Start"/>
  <Method name="startServer"/>
</Match>
<Match>
  <Bug pattern="WEAK_MESSAGE_DIGEST_MD5"/>
  <Class name="dev.luin.file.server.web.WebAuthentication"/>
  <Method name="toMD5"/>
</Match>
</FindBugsFilter>
