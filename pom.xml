    <dependency>
      <groupId>dev.luin.file.server</groupId>
      <artifactId>file-server-core</artifactId>
      <version>${project.parent.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
